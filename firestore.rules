rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email == 'dlehdrb005@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function validEntry() {
      return request.resource.data.keys().hasAll(['title', 'body', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'body', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
        && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 60
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }
    function owner() { return signedIn() && resource.data.authorUid == request.auth.uid; }
    function validEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000;
    }
    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['nickname', 'photoURL', 'photoPath', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'photoURL', 'photoPath', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2 && request.resource.data.nickname.size() <= 20
        && (admin() || !(request.resource.data.nickname.lower() in ['관리자', '운영자', 'vsphere']))
        && request.resource.data.photoURL is string && request.resource.data.photoURL.size() <= 2048
        && (request.resource.data.photoURL == '' || request.resource.data.photoURL.matches('https://.*'))
        && request.resource.data.photoPath is string && request.resource.data.photoPath.size() <= 200
        && (request.resource.data.photoPath == '' || request.resource.data.photoPath.matches('avatars/' + uid + '/.*'))
        && request.resource.data.updatedAt == request.time;
    }
    match /notices/{id} {
      allow read: if true;
      allow create: if admin() && validEntry();
      allow delete: if admin();
      allow update: if admin() && owner() && validEdit();
    }
    match /messages/{id} {
      allow read: if true;
      allow create: if signedIn() && validEntry();
      allow delete: if owner() || admin();
      allow update: if owner() && validEdit();
    }
  }
}
