rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email == 'dlehdrb005@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function validEntry() {
      return request.resource.data.keys().hasAll(['title', 'body', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['title', 'body', 'authorUid', 'authorName', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000
        && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 60
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }
    function owner() { return signedIn() && resource.data.authorUid == request.auth.uid; }
    function validEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 3000;
    }
    match /profilePhotos/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['photoData'])
        && request.resource.data.keys().hasOnly(['photoData'])
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 60000
        && (request.resource.data.photoData == ''
          || request.resource.data.photoData.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }
    match /notices/{id} {
      allow read: if true;
      allow create: if admin() && validEntry();
      allow delete: if admin();
      allow update: if admin() && owner() && validEdit();
    }
    match /messages/{id} {
      allow read: if true;
      allow create: if signedIn() && validEntry();
      allow delete: if owner() || admin();
      allow update: if owner() && validEdit();
    }
  }
}
